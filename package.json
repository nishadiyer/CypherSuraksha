{
  "name": "ai-shield",
  "version": "1.0.0",
  "private": true,
  "description": "On-device protection from AI-driven threats: Privacy, Pixels, People.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/verify-build.mjs",
    "dev": "vite",
    "test": "vitest run",
    "test:e2e": "npm run build && node tests/e2e/run.mjs",
    "audit:final": "node scripts/final-audit.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "models": "node scripts/fetch-models.mjs",
    "fixtures": "python3 -I scripts/fetch-deepfake-fixture.py",
    "models:cloak": "bash scripts/cloak/build-models.sh",
    "models:gend": "bash scripts/people/build-gend.sh",
    "demo:prepare": "node scripts/demo/prepare.mjs",
    "build:demo": "tsc --noEmit && AISHIELD_DEMO=1 vite build --outDir dist-demo && node scripts/verify-build.mjs dist-demo"
  },
  "dependencies": {
    "onnxruntime-web": "^1.31.1",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.33",
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.3.7",
    "autoprefixer": "^10.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.33",
    "puppeteer-core": "^25.18.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
